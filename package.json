    "@angular/platform-browser": "^21.2.24",
    "@angular/router": "^21.2.24",
    "@azure/msal-browser": "^4.26.1",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
