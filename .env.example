# Frontend identity configuration
VITE_AZURE_REDIRECT_URI=http://localhost:4200/
VITE_ENTRA_CLIENT_ID=replace-with-local-client-id
VITE_ENTRA_TENANT_ID=replace-with-local-tenant-id
VITE_API_BASE_URL=http://localhost:5001/api

# Backend local development
NODE_ENV=development
PORT=5001
DB_DRIVER=sqlite
DATABASE_PATH=.local/song-site.sqlite
# Use either DATABASE_URL or the explicit PG* settings when the PostgreSQL adapter is available.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=song_site
PGUSER=
PGPASSWORD=
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PGSSL=false
SWAGGER_UI=true