# Frontend identity configuration
VITE_AZURE_REDIRECT_URI=http://localhost:4200/
VITE_ENTRA_CLIENT_ID=replace-with-local-client-id
VITE_ENTRA_TENANT_ID=replace-with-local-tenant-id
VITE_API_BASE_URL=http://localhost:5001/api

# Backend configuration. VITE_* values are public frontend build configuration;
# they are embedded into the Angular bundle and must not contain secrets.
NODE_ENV=development
PORT=5001
DB_DRIVER=postgres
DATABASE_PATH=.local/song-site.sqlite
# For Azure PostgreSQL, keep DATABASE_URL empty and use the explicit PG* settings.
# Do not commit real Azure credentials or a connection string.
DATABASE_URL=
PGHOST=pg-song-site-dev.postgres.database.azure.com
PGPORT=5432
PGDATABASE=song_site
PGUSER=replace-with-azure-postgres-user
PGPASSWORD=replace-with-azure-postgres-password
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PGSSL=true

# Docker Compose local PostgreSQL path. These values are local-only defaults.
POSTGRES_DB=song_site
POSTGRES_USER=song_site
POSTGRES_PASSWORD=song_site_local
BACKEND_PORT=5001
FRONTEND_PORT=4200
TEMP_CONTENT_API_KEY=compose-local-content-key
SWAGGER_UI=true
